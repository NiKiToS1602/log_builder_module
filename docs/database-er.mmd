        bigint organization_id PK,FK
        uuid id PK
        uuid journal_id FK
        uuid template_id FK
        uuid entry_id FK
        uuid actor_uid FK
        text event_type
        timestamptz occurred_at
        jsonb before_data
        jsonb after_data
    }

