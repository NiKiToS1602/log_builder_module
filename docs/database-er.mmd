        bigint location_id FK
        uuid responsible_uid FK
        uuid created_by_uid FK
        text name
        text status
        bigint next_entry_number
        bigint version
    }
    journal_field {
        bigint organization_id PK,FK
        uuid id PK
        uuid journal_id FK
