        bigint organization_id PK,FK
        uuid journal_id PK,FK
        uuid entry_id PK,FK
        uuid field_id PK,FK
        uuid confirmer_uid FK
        text full_name_snapshot
        text role_snapshot
        timestamptz confirmed_at
